# ===== API Keys (각자 본인 키로 채우세요) =====
# 이 파일을 복사해서 backend/.env 를 만들고 값을 채우세요.
#   cp backend/.env.example backend/.env
#
# ⚠️ backend/.env 파일은 절대 Git에 커밋하지 마세요 (.gitignore에 포함되어 있음)

# ------- Claude -------
# Claude는 두 가지 방법 중 하나를 선택할 수 있습니다 (아래 A 또는 B 중 택 1)
#
# [A] Anthropic API 직접 호출 (AWS 불필요, 권장)
#     https://console.anthropic.com/settings/keys 에서 발급
ANTHROPIC_API_KEY=sk-ant-your-key-here
#
# [B] AWS Bedrock 경유 (ANTHROPIC_API_KEY가 비어있을 때만 사용됨)
#     - AWS 자격증명은 ~/.aws/credentials 또는 AWS_ACCESS_KEY_ID/SECRET 환경변수로 설정
#     - Bedrock 콘솔에서 해당 모델의 access 승인 필요
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# ------- OpenAI (GPT) -------
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# ------- Google Gemini -------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# ------- JWT 시크릿 -------
# 각자 임의 문자열 생성 권장: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string

# ------- (선택) 모델 ID 오버라이드 -------
# ANTHROPIC_MODEL_ID=claude-sonnet-4-5-20250929
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# OPENAI_MODEL_ID=gpt-4o
# GEMINI_MODEL_ID=gemini-2.5-flash
